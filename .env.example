# Copy to .env (never commit it) or set these in your hosting dashboard.
PORT=3000
NODE_ENV=production
# First run only: creates the administrator. If ADMIN_PASSWORD is omitted a one-time password is printed in the log.
ADMIN_EMAIL=admin@yourschool.org
ADMIN_PASSWORD=
# Behind a reverse proxy / host that terminates HTTPS (Render, Railway, Fly, nginx...): number of proxies.
TRUST_PROXY=1
# ---------------------------------------------------------------------------------------------------------------------
# DATABASE (Supabase / PostgreSQL). Full guide: docs/SUPABASE.md. These two values are SECRETS: they exist only on the server,
# never in browser code, never in a "public" / NEXT_PUBLIC_ / VITE_ variable, never in Git.
# ---------------------------------------------------------------------------------------------------------------------
# What the running portal uses: the Supabase SESSION POOLER connection string (Dashboard > Connect > Session pooler, port 5432),
# with the user changed to the limited role the migration creates:  eagle_app.<your-project-ref>
# (The direct connection string is IPv6-only and fails on hosts without IPv6, such as Render. Do not use port 6543.)
DATABASE_URL=postgresql://eagle_app.YOUR_PROJECT_REF:YOUR_EAGLE_APP_PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres
# Only for `npm run migrate` and `npm run migrate:from-sqlite`: a privileged role (Supabase "postgres"). Keep it on your own computer or in a
# CI secret; do NOT set it on the web server.
# MIGRATION_DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres
# TLS to the database is verified by default. Only if the certificate cannot be verified, supply Supabase's root certificate (Dashboard >
# Database > Settings > SSL configuration) as PEM text in DATABASE_CA (use \n for line breaks). `DATABASE_SSL=no-verify` encrypts but does
# NOT authenticate the server; `off` is only for a database on your own machine.
# DATABASE_SSL=verify
# DATABASE_CA=
# DB_POOL_MAX=10                       connections this server may hold (Supabase plans have a connection limit; keep it well below it)
# DB_STATEMENT_TIMEOUT_MS=20000        any single query is cancelled after this long
# Backups: Supabase keeps its own (see your plan). `npm run backup` makes an extra, independent file (docs/RECOVERY.md).
# BACKUP_DIR=./backups
# Logging: JSON lines by default (LOG_FORMAT=text for humans). LOG_LEVEL=silent turns logging off. Queries, bodies and headers are never logged.
LOG_FORMAT=json
LOG_LEVEL=info
# CSV import limits (the HTTP body limit of 1 MB also applies)
CSV_MAX_ROWS=1000
CSV_MAX_BYTES=1000000

# ---------------------------------------------------------------------------------------------------------------------
# Email sign-in codes (OTP) through Gmail. Full guide: docs/EMAIL_OTP.md. Placeholders only: put real values in .env or in
# the Render dashboard, never in this file.
# ---------------------------------------------------------------------------------------------------------------------
# A DEDICATED Gmail account and a Google APP PASSWORD (16 characters; Google shows it in 4 groups, spaces are ignored).
# Never use the account's normal password.
GMAIL_USER=your-dedicated-gmail@gmail.com
GMAIL_APP_PASSWORD=your-google-app-password
# Public address of this portal (used for the logo in emails): no trailing slash.
APP_BASE_URL=https://your-app.onrender.com
# Who must enter an emailed code after their password:  staff (default: administrators + teachers) | all (also students) | off (emergency switch)
OTP_LOGIN_MODE=staff
# Who may sign in with ONLY an emailed code (no password): student (default) | student,teacher | admin (must be named) | none (switch the option off)
# OTP_CODE_LOGIN_ROLES=student
# A long random string (32+ characters) that keys the code hashes. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Optional but recommended: without it a random per-process key is used (pending codes simply stop working after a restart). REQUIRED if you ever run
# more than one server process, so that every process can verify a code that another one sent.
OTP_SECRET=
# Optional tuning (defaults shown). Limits are enforced on the server and survive restarts.
# OTP_TTL_SECONDS=300                  how long a code is valid
# OTP_MAX_ATTEMPTS=5                   wrong guesses allowed per code
# OTP_MAX_TOTAL_ATTEMPTS=10            wrong guesses allowed per sign-in, however many codes are resent
# OTP_RESEND_COOLDOWN_SECONDS=60       wait between codes
# OTP_MAX_RESENDS=3                    replacement codes per sign-in
# OTP_CHALLENGE_TTL_SECONDS=900        how long the code screen stays usable
# OTP_MAX_SENDS_PER_USER_HOUR=6        emails per account per hour
# OTP_MAX_REQUESTS_PER_IP_HOUR=100     code requests per network address per hour (raise it if a whole school shares one address)
# OTP_MAX_FAILS_PER_USER=10            wrong codes per account per 15 minutes before a lock
# OTP_MAX_FAILS_PER_IP=60              wrong codes per network address per 15 minutes before a lock
# OTP_BURST_PER_IP_10MIN=600           requests to the code endpoints per address per 10 minutes
# OTP_MIN_RESPONSE_MS=600              sign-in code answers are never faster than this, so response time cannot reveal which addresses have accounts (0 = off, tests only)
# SMTP_PORT=465                        465 (implicit TLS, default) or 587 (STARTTLS)
# MAIL_FROM_NAME=Eagle Labs Exam Portal

# ---- Wrong-password limits (v2.4) --------------------------------------------------------------------------------
# LOGIN_MAX_FAILS_PER_ACCOUNT=8     wrong passwords per account per 10 minutes before that account is paused (3-50)
# LOGIN_MAX_FAILS_PER_IP=150        wrong passwords per network address per 10 minutes. A whole school often shares ONE
#                                   public address, so this is deliberately generous; lower it only if each user has their own address (10-5000)
